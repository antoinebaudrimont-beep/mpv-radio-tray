#!/usr/bin/env python3

import json
import os
import pathlib
import signal
import socket
import subprocess
import tempfile
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk


CONFIG_DIR = pathlib.Path.home() / ".config" / "mpv-radio-tray"
STATIONS_FILE = CONFIG_DIR / "stations.txt"

CHECK_INTERVAL_SECONDS = 5
STARTUP_GRACE_SECONDS = 12
BUFFERING_RESTART_SECONDS = 35
IPC_MISSING_RESTART_SECONDS = 25
STALLED_PLAYBACK_RESTART_SECONDS = 60
RESTART_COOLDOWN_SECONDS = 10
BLUETOOTH_CONNECT_TIMEOUT_SECONDS = 12

player = None
current_station = None
selected_audio_device = None
started_at = 0.0
last_restart_at = 0.0
last_ipc_ok_at = 0.0
last_time_pos = None
last_time_pos_changed_at = 0.0
time_pos_has_moved = False
buffering_since = None
ipc_path = None
station_menu_items = []
output_menu_items = []
updating_output_menu = False


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if base:
        return pathlib.Path(base)
    return pathlib.Path(tempfile.gettempdir())


def load_stations():
    stations = []
    if not STATIONS_FILE.exists():
        return stations

    for line in STATIONS_FILE.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "|" not in line:
            continue
        name, url = line.split("|", 1)
        stations.append((name.strip(), url.strip()))

    return stations


def remove_ipc_socket():
    if ipc_path:
        try:
            pathlib.Path(ipc_path).unlink()
        except FileNotFoundError:
            pass
        except OSError:
            pass


def new_ipc_path():
    return str(runtime_dir() / f"mpv-radio-tray-{os.getpid()}.sock")


def stop_player():
    global player

    if player and player.poll() is None:
        try:
            os.killpg(player.pid, signal.SIGTERM)
            player.wait(timeout=2)
        except Exception:
            try:
                os.killpg(player.pid, signal.SIGKILL)
            except Exception:
                pass

    player = None
    remove_ipc_socket()


def stop_current_station():
    global current_station

    current_station = None
    stop_player()
    update_station_menu_state()


def start_player(name, url):
    global buffering_since
    global ipc_path
    global last_ipc_ok_at
    global last_time_pos
    global last_time_pos_changed_at
    global player
    global started_at
    global time_pos_has_moved

    remove_ipc_socket()
    ipc_path = new_ipc_path()
    now = time.monotonic()
    started_at = now
    last_ipc_ok_at = now
    last_time_pos = None
    last_time_pos_changed_at = now
    time_pos_has_moved = False
    buffering_since = None

    command = [
        "mpv",
        "--no-video",
        "--force-window=no",
        "--quiet",
        f"--input-ipc-server={ipc_path}",
        "--network-timeout=15",
        "--cache=yes",
    ]
    if selected_audio_device:
        command.append(f"--audio-device={selected_audio_device}")
    command.append(url)

    player = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def play_station(name, url):
    global current_station

    current_station = (name, url)
    stop_player()
    start_player(name, url)
    update_station_menu_state()


def update_station_menu_state():
    for item, name, url in station_menu_items:
        is_current = current_station == (name, url)
        if item.get_active() != is_current:
            item.set_active(is_current)


def activate_station_menu_item(item, name, url):
    if item.get_active():
        play_station(name, url)
    elif current_station == (name, url):
        item.set_active(True)


def restart_current_station(reason):
    global last_restart_at

    if not current_station:
        return

    now = time.monotonic()
    if now - last_restart_at < RESTART_COOLDOWN_SECONDS:
        return

    last_restart_at = now
    name, url = current_station
    stop_player()
    start_player(name, url)


def mpv_command(command):
    if not ipc_path:
        return None

    request_id = int(time.monotonic() * 1000)
    payload = json.dumps({"command": command, "request_id": request_id}).encode()

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(1.0)
            sock.connect(ipc_path)
            sock.sendall(payload + b"\n")

            buffer = b""
            while True:
                chunk = sock.recv(4096)
                if not chunk:
                    return None
                buffer += chunk
                while b"\n" in buffer:
                    line, buffer = buffer.split(b"\n", 1)
                    if not line:
                        continue
                    response = json.loads(line.decode("utf-8"))
                    if response.get("request_id") == request_id:
                        return response
    except Exception:
        return None


def mpv_property(name):
    response = mpv_command(["get_property", name])
    if not response or response.get("error") != "success":
        return None
    return response.get("data")


def run_command(command, timeout=3):
    try:
        completed = subprocess.run(
            command,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
    except Exception:
        return None

    if completed.returncode != 0:
        return None

    return completed.stdout


def pactl_sinks():
    output = run_command(["pactl", "-f", "json", "list", "sinks"])
    if output:
        try:
            sinks = json.loads(output)
            return [
                {
                    "name": sink.get("name", ""),
                    "description": sink.get("description", sink.get("name", "")),
                }
                for sink in sinks
                if sink.get("name")
            ]
        except json.JSONDecodeError:
            pass

    output = run_command(["pactl", "list", "short", "sinks"])
    if not output:
        return []

    sinks = []
    for line in output.splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            sinks.append({"name": parts[1], "description": parts[1]})
    return sinks


def is_bluetooth_sink(sink_name):
    return sink_name.startswith("bluez_") or ".bluez" in sink_name


def default_sink_name():
    output = run_command(["pactl", "get-default-sink"])
    if not output:
        return None
    return output.strip() or None


def computer_sink_name():
    current = default_sink_name()
    if current and not is_bluetooth_sink(current):
        return current

    for sink in pactl_sinks():
        name = sink["name"]
        if not is_bluetooth_sink(name):
            return name

    return None


def bluetooth_devices():
    output = run_command(["bluetoothctl", "devices"])
    if not output:
        return []

    devices = []
    for line in output.splitlines():
        parts = line.strip().split(" ", 2)
        if len(parts) == 3 and parts[0] == "Device":
            devices.append((parts[1], parts[2]))
    return devices


def bluetooth_sink_name(address):
    address_part = address.replace(":", "_").upper()
    matches = [
        sink["name"]
        for sink in pactl_sinks()
        if sink["name"].startswith(f"bluez_output.{address_part}.")
    ]
    if not matches:
        return None

    for name in matches:
        if "a2dp" in name.lower():
            return name

    return matches[0]


def selected_sink_name():
    pulse_prefix = "pulse/"
    if selected_audio_device and selected_audio_device.startswith(pulse_prefix):
        return selected_audio_device[len(pulse_prefix) :]
    return default_sink_name()


def update_output_menu_state():
    global updating_output_menu

    sink_name = selected_sink_name()
    updating_output_menu = True

    try:
        for item, address in output_menu_items:
            if not sink_name:
                is_selected = False
            elif address is None:
                is_selected = not is_bluetooth_sink(sink_name)
            else:
                address_part = address.replace(":", "_").upper()
                is_selected = sink_name.startswith(f"bluez_output.{address_part}.")

            if item.get_active() != is_selected:
                item.set_active(is_selected)
    finally:
        updating_output_menu = False

    return False


def set_output_sink(sink_name):
    global selected_audio_device

    selected_audio_device = f"pulse/{sink_name}"

    if current_station:
        mpv_command(["set_property", "audio-device", selected_audio_device])

    GLib.idle_add(update_output_menu_state)


def select_computer_output():
    sink_name = computer_sink_name()
    if sink_name:
        set_output_sink(sink_name)


def select_bluetooth_output(address):
    run_command(
        ["bluetoothctl", "connect", address],
        timeout=BLUETOOTH_CONNECT_TIMEOUT_SECONDS,
    )

    deadline = time.monotonic() + BLUETOOTH_CONNECT_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        sink_name = bluetooth_sink_name(address)
        if sink_name:
            set_output_sink(sink_name)
            return
        time.sleep(0.5)


def run_in_background(function, *args):
    thread = threading.Thread(target=function, args=args, daemon=True)
    thread.start()


def select_output_in_background(function, *args):
    if updating_output_menu:
        return

    GLib.idle_add(update_output_menu_state)
    run_in_background(function, *args)


def watchdog_tick():
    global buffering_since
    global last_ipc_ok_at
    global last_time_pos
    global last_time_pos_changed_at
    global time_pos_has_moved

    if not current_station:
        return True

    now = time.monotonic()

    if not player or player.poll() is not None:
        restart_current_station("mpv exited")
        return True

    paused_for_cache = mpv_property("paused-for-cache")
    if paused_for_cache is None:
        if now - started_at > STARTUP_GRACE_SECONDS and now - last_ipc_ok_at > IPC_MISSING_RESTART_SECONDS:
            restart_current_station("mpv IPC unavailable")
        return True

    last_ipc_ok_at = now

    if bool(paused_for_cache):
        if buffering_since is None:
            buffering_since = now
        elif now - buffering_since >= BUFFERING_RESTART_SECONDS:
            restart_current_station("buffering too long")
    else:
        buffering_since = None

    if now - started_at > STARTUP_GRACE_SECONDS:
        time_pos = mpv_property("time-pos")
        if isinstance(time_pos, (int, float)):
            if last_time_pos is None:
                last_time_pos = time_pos
                last_time_pos_changed_at = now
            elif time_pos > last_time_pos + 0.25:
                last_time_pos = time_pos
                last_time_pos_changed_at = now
                time_pos_has_moved = True
            elif time_pos_has_moved and now - last_time_pos_changed_at >= STALLED_PLAYBACK_RESTART_SECONDS:
                restart_current_station("playback time stalled")

        core_idle = mpv_property("core-idle")
        eof_reached = mpv_property("eof-reached")
        if core_idle or eof_reached:
            restart_current_station("stream ended or idle")

    return True


def quit_app(*args):
    stop_player()
    Gtk.main_quit()


def build_menu():
    global output_menu_items
    global station_menu_items

    menu = Gtk.Menu()
    output_menu_items = []
    station_menu_items = []

    title = Gtk.MenuItem(label="mpv Radio Tray")
    title.set_sensitive(False)
    menu.append(title)

    menu.append(Gtk.SeparatorMenuItem())

    stations = load_stations()

    if not stations:
        item = Gtk.MenuItem(label="No stations configured")
        item.set_sensitive(False)
        menu.append(item)
    else:
        for name, url in stations:
            item = Gtk.CheckMenuItem(label=name)
            item.set_draw_as_radio(True)
            item.set_active(current_station == (name, url))
            item.connect(
                "activate",
                lambda menu_item, n=name, u=url: activate_station_menu_item(menu_item, n, u),
            )
            station_menu_items.append((item, name, url))
            menu.append(item)

    menu.append(Gtk.SeparatorMenuItem())

    output_item = Gtk.MenuItem(label="Output")
    output_menu = Gtk.Menu()

    computer_item = Gtk.CheckMenuItem(label="Computer")
    computer_item.set_draw_as_radio(True)
    computer_item.connect(
        "activate",
        lambda _item: select_output_in_background(select_computer_output),
    )
    output_menu_items.append((computer_item, None))
    output_menu.append(computer_item)

    output_menu.append(Gtk.SeparatorMenuItem())

    devices = bluetooth_devices()
    if not devices:
        no_devices_item = Gtk.MenuItem(label="No Bluetooth devices listed")
        no_devices_item.set_sensitive(False)
        output_menu.append(no_devices_item)
    else:
        for address, name in devices:
            device_item = Gtk.CheckMenuItem(label=name)
            device_item.set_draw_as_radio(True)
            device_item.connect(
                "activate",
                lambda _item, a=address: select_output_in_background(select_bluetooth_output, a),
            )
            output_menu_items.append((device_item, address))
            output_menu.append(device_item)

    output_menu.connect("show", lambda _menu: update_output_menu_state())
    update_output_menu_state()
    output_item.set_submenu(output_menu)
    menu.append(output_item)

    menu.append(Gtk.SeparatorMenuItem())

    stop = Gtk.MenuItem(label="Stop")
    stop.connect("activate", lambda _item: stop_current_station())
    menu.append(stop)

    quit_item = Gtk.MenuItem(label="Quit")
    quit_item.connect("activate", quit_app)
    menu.append(quit_item)

    menu.show_all()
    return menu


def start_indicator():
    try:
        gi.require_version("AyatanaAppIndicator3", "0.1")
        from gi.repository import AyatanaAppIndicator3 as AppIndicator3

        indicator = AppIndicator3.Indicator.new(
            "mpv-radio-tray",
            "multimedia-player",
            AppIndicator3.IndicatorCategory.APPLICATION_STATUS,
        )
        indicator.set_status(AppIndicator3.IndicatorStatus.ACTIVE)
        indicator.set_menu(build_menu())
        return indicator

    except Exception:
        icon = Gtk.StatusIcon()
        icon.set_from_icon_name("multimedia-player")
        icon.set_tooltip_text("mpv Radio Tray")
        icon.set_visible(True)

        def popup(_icon, button, activate_time):
            build_menu().popup(None, None, None, None, button, activate_time)

        icon.connect("popup-menu", popup)
        icon.connect(
            "activate",
            lambda _icon: build_menu().popup(
                None,
                None,
                None,
                None,
                0,
                Gtk.get_current_event_time(),
            ),
        )
        return icon


def main():
    signal.signal(signal.SIGINT, quit_app)
    signal.signal(signal.SIGTERM, quit_app)

    tray = start_indicator()
    GLib.timeout_add_seconds(CHECK_INTERVAL_SECONDS, watchdog_tick)
    Gtk.main()
    return tray


if __name__ == "__main__":
    main()
